{
  "name": "sheetscale-desktop",
  "productName": "SheetScale",
  "version": "1.2.0",
  "description": "SheetScale - private PDF markup and measurement (desktop)",
  "author": "Andrew Pocta",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "stage": "rm -rf app && cp -r ../dist app",
    "start": "npm run stage && electron .",
    "dist:mac": "npm run stage && electron-builder --mac zip --arm64 --x64 --publish never -c.mac.identity=null",
    "dist:linux": "npm run stage && electron-builder --linux dir --publish never",
    "dist:mas": "npm run stage && electron-builder --mac mas --universal --publish never",
    "dist:mas-dev": "npm run stage && electron-builder --mac mas-dev --arm64 --publish never",
    "dist:mas-unsigned": "npm run stage && electron-builder --mac mas --universal --publish never -c.mas.identity=null -c.mas.provisioningProfile=null"
  },
  "build": {
    "appId": "com.andrewpocta.sheetscale",
    "productName": "SheetScale",
    "copyright": "Copyright 2026 Andrew Pocta",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "SheetScale-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/pdf"
      }
    ],
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "mas": {
      "target": [
        {
          "target": "mas",
          "arch": [
            "universal"
          ]
        }
      ],
      "type": "distribution",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "preAutoEntitlements": true,
      "minimumSystemVersion": "12.0",
      "category": "public.app-category.productivity",
      "artifactName": "SheetScale-${version}-mas.${ext}"
    },
    "masDev": {
      "type": "development",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "preAutoEntitlements": true,
      "artifactName": "SheetScale-${version}-mas-dev.${ext}",
      "provisioningProfile": "build/development.provisionprofile"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
